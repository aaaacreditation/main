# Postgres (docker compose up -d starts a local instance on port 5435)
DATABASE_URL="postgresql://aaa:aaa_dev_password@localhost:5435/aaa_cms?schema=public"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Initial admin credentials used by `npm run db:seed`
ADMIN_EMAIL="admin@aaa-accreditation.org"
ADMIN_PASSWORD=""

# SMTP for emailing /apply requests (port 465 = TLS, 587 = STARTTLS).
# SMTP_FROM defaults to "AAA Website" <SMTP_USER>; LEADS_EMAIL_TO defaults to info@aaa-accreditation.org.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_EMAIL_TO=
