# Caddy front for a STAGING hostname (Nov 2026: preview.aaa-accreditation.org
# on the Contabo VPS). Same as deploy/Caddyfile minus the www → apex block:
# a staging subdomain has no www record, and Caddy would retry certificate
# issuance for it forever.
#
#   CADDYFILE=Caddyfile.preview SITE_DOMAIN=preview.aaa-accreditation.org \
#     docker compose -f docker-compose.prod.yml --profile caddy up -d
#
# (Both variables live in /opt/aaa-web/app/.env on the server, which compose
# reads automatically.) Pair it with NOINDEX=true and
# AUTH_URL=https://<SITE_DOMAIN> in deploy/.env.production.
{
	email {$ACME_EMAIL:webmaster@aaa-accreditation.org}
}

{$SITE_DOMAIN:preview.aaa-accreditation.org} {
	encode zstd gzip

	# Staging copy of the live site: keep every page out of search results
	# (robots.txt also disallows everything when NOINDEX=true).
	header X-Robots-Tag "noindex, nofollow"

	request_body {
		max_size 10MB
	}

	# ADCP certificate SPA and legacy WordPress uploads — served exactly as in
	# deploy/Caddyfile, from the same (possibly empty) mounted folders.
	redir /adcp /adcp/ 308
	handle /adcp/static/* {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /adcp/* {
		root * /srv/www
		header Cache-Control "no-cache"
		try_files {path} /adcp/index.html
		file_server
	}

	@wpUploads path_regexp wpup ^/wp-content/uploads/.+\.(pdf|docx?|xlsx?|pptx?|jpe?g|png|gif|webp)$
	handle @wpUploads {
		root * /srv/www
		header Cache-Control "public, max-age=2592000"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle /wp-content/* {
		respond 404
	}

	handle {
		reverse_proxy app:3000
	}
}
