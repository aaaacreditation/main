# AAA website — production environment for docker-compose.prod.yml.
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# deploy/.env.production is gitignored. Never commit it, never paste it into
# chat or tickets. The same variables (minus POSTGRES_* and RUN_SEED) are what
# the Vercel project needs — see docs/DEPLOYMENT.md.
#
# This one file is read by the app, db and backup services (not by caddy —
# its two settings, ACME_EMAIL and SITE_DOMAIN, are optional shell variables;
# see docker-compose.prod.yml).

# ─── Database ────────────────────────────────────────────────────────────────
# Credentials for the bundled `db` service (postgres:16-alpine, no public port).
# Generate the password with:  openssl rand -hex 24
POSTGRES_USER=aaa
POSTGRES_PASSWORD=
POSTGRES_DB=aaa_cms

# Leave EMPTY with the bundled db service: the entrypoint builds it from the
# POSTGRES_* values above (postgresql://aaa:<pw>@db:5432/aaa_cms?schema=public).
# Set it only to use an external database instead (then the db service is
# unused). Prisma reads this; the app has no other database setting.
DATABASE_URL=

# ─── Auth (NextAuth v5) ──────────────────────────────────────────────────────
# Signs the admin session JWTs. Generate with:  openssl rand -base64 32
# Rotating it signs every staff member out.
AUTH_SECRET=
# Behind nginx/Caddy the app must trust X-Forwarded-Host / -Proto.
AUTH_TRUST_HOST=true
# Public origin of the site (no trailing slash). Use the staging hostname while
# testing before the DNS cut-over.
AUTH_URL=https://aaa-accreditation.org

# ─── First admin (read by the seed only) ─────────────────────────────────────
# Used when the container starts with RUN_SEED=1 (or `run --rm app seed`).
# The seed upserts this user as ADMIN; it never changes an existing user's
# password. Seeding refuses to run with an empty ADMIN_PASSWORD.
ADMIN_EMAIL=admin@aaa-accreditation.org
ADMIN_PASSWORD=

# 1 = run prisma/seed.mjs on startup (admin user, 347 posts, case studies,
# accredited register). Set it for the FIRST boot only, then back to 0: the
# seed re-imports any snapshot post whose slug is missing, so leaving it on
# would resurrect articles deleted in the admin on every restart.
RUN_SEED=0

# 1 = skip `prisma migrate deploy` at startup (emergencies only).
SKIP_MIGRATIONS=0

# ─── Email (lead / application notifications, lib/mailer.ts) ─────────────────
# Port 465 = implicit TLS, 587 = STARTTLS. Without SMTP_HOST the site still
# stores every lead in the database; it just sends no email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to "AAA Website" <SMTP_USER>
SMTP_FROM=
# Where lead notifications go. Defaults to info@aaa-accreditation.org (lib/facts.ts).
LEADS_EMAIL_TO=

# ─── Search engines ──────────────────────────────────────────────────────────
# true = robots.txt disallows everything (app/robots.ts). Use on a staging
# hostname; MUST be unset/false on the production domain.
NOINDEX=false

# ─── Admin SEO audit (lib/seo-audit.ts) ───────────────────────────────────────
# Base URL the audit crawler fetches pages from. Empty = the origin of the admin
# request that started the audit. In this container, http://127.0.0.1:3000
# crawls the app directly (no proxy/TLS hop) and also works before the DNS
# cut-over, when the admin is reached through an SSH tunnel.
SEO_AUDIT_BASE_URL=http://127.0.0.1:3000

# ─── Backups (backup service, deploy/backup.sh) ──────────────────────────────
# Daily pg_dump time (UTC, HH:MM) and how many days of dumps to keep.
BACKUP_AT=02:30
BACKUP_RETENTION_DAYS=14

